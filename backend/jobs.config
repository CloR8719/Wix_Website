{
  "jobs": [
    {
      "functionLocation": "/queueMonitor.sweepEmailQueue",
      "description": "Checks the Email Queue every hour for stuck invites",
      "executionConfig": {
        "cronExpression": "0 * * * *"
      }
    },
    {
      "functionLocation": "/gocardlessCleanup.pruneGoCardlessWebhookEvents",
      "description": "Deletes GoCardless webhook event log rows older than 30 days - they only exist for retry-idempotency, and GoCardless's own retry window is a few days",
      "executionConfig": {
        "cronExpression": "0 3 * * 0"
      }
    },
    {
      "functionLocation": "/fixturesRollup.rollUpFixtureResponses",
      "description": "Archives RSVPs onto the fixture row once an event has passed, then deletes the live rows - what keeps FixtureResponses flat instead of ~17,000 rows a season. Nightly rather than weekly so a Tuesday fixture isn't left unarchived for days, and self-healing: it picks up anything a missed run left behind",
      "executionConfig": {
        "cronExpression": "0 2 * * *"
      }
    },
    {
      "functionLocation": "/potmPoster.postDuePlayerOfTheMatch",
      "description": "Posts one Player of the Match award to Facebook per run. Hourly IS the spacing - a job cannot pause between posts, so posting everything due would put five awards up in the same minute. Runs every hour rather than only Monday: the query returns nothing on a Wednesday, and a Tuesday overflow drains without a second entry. Self-healing like the fixtures rollup - a missed run costs an hour, not a post.",
      "executionConfig": {
        "cronExpression": "0 * * * *"
      }
    }
  ]
}
