import wixData from 'wix-data';
import { mediaManager } from 'wix-media-backend';

export async function getTeamsExportUrl() {
  try {
    const allTeams = await getAll("Teams");

    if (!allTeams.length) return null;

    const esc = (v) => {
      if (v === null || v === undefined) return "";
      return `"${String(v).replace(/"/g, '""')}"`;
    };

    const csvLines = ["Team Name,Age Group,Manager,Division,Registered"];

    allTeams.forEach(team => {
      const teamName = team.T_teamName || "";
      const ageGroup = team.AG_ageGroup ? team.AG_ageGroup.AG_ageGroup : "N/A";
      const manager = team.T_teamManager ? team.T_teamManager.SS_name : "No Manager";
      const division = team.leagueDivision || "";
      const registered = team.leagueRegister ? "Yes" : "No";

      csvLines.push([
        esc(teamName),
        esc(ageGroup),
        esc(manager),
        esc(division),
        esc(registered)
      ].join(","));
    });

    const csvString = csvLines.join("\n");
    const buffer = Buffer.from(csvString, 'utf8');
    const fileName = `Signol_Export_${Date.now()}.csv`;

    // --- THE FAILSAVE UPLOAD CALL ---
    // We are stripping this to the absolute minimum 
    // to prevent any "Property not found" errors.
    const uploadResult = await mediaManager.upload(
      "/TeamReports",
      buffer,
      fileName,
      {
        mediaOptions: {
          mimeType: "text/csv"
        }
      }
    );

    return uploadResult.fileUrl;
  } catch (err) {
    console.error("Ultimate Export Error:", err);
    return null;
  }
}

async function getAll(collectionId) {
  let items = [];
  let res = await wixData.query(collectionId)
    .include("T_teamManager", "AG_ageGroup")
    .limit(1000)
    .find({ suppressAuth: true });
    
  items = items.concat(res.items);
  while (res.hasNext()) {
    res = await res.next();
    items = items.concat(res.items);
  }
  return items;
}
// Add this to your existing backend/exportCsv.jsw file
export async function getStaffExportUrl() {
  try {
    const res = await wixData.query("SignolStaff")
      .include("SS_team", "SS_role", "SS_Qualifications") 
      .ascending("SS_name")
      .limit(1000)
      .find({ "suppressAuth": true });

    const staff = res.items;
    if (!staff.length) return null;

    const esc = (v) => {
      if (v === null || v === undefined) return "";
      return `"${String(v).replace(/"/g, '""')}"`;
    };

    const formatDate = (date) => date ? new Date(date).toISOString().split('T')[0] : "N/A";

    let csvLines = [
        "Name,Teams,Roles,FAN Number,DOB,Address,Mobile,Email,Qualifications,DBS Expiry,Safeguarding Expiry,First Aid Expiry,Coaching Expiry"
    ];

    staff.forEach(person => {
      const teams = person.SS_team ? person.SS_team.map(t => t.T_teamName).join(" | ") : "None";
      const roles = person.SS_role ? person.SS_role.map(r => r.CR_role).join(" | ") : "None";
      const quals = person.SS_Qualifications ? person.SS_Qualifications.map(q => q.Q_badgeName).join(" | ") : "None";

      csvLines.push([
        esc(person.SS_name),
        esc(teams),
        esc(roles),
        esc(person.fanNumber),
        esc(formatDate(person.dob)),
        esc(person.address),
        esc(person.mobile),
        esc(person.emailAddress),
        esc(quals),
        esc(formatDate(person.dbsExpiry)),
        esc(formatDate(person.safeGuardingExpiry)),
        esc(formatDate(person.firstAidExpiry)),
        esc(formatDate(person.coachingExpiry))
      ].join(","));
    });

    const csvString = csvLines.join("\n");
    const buffer = Buffer.from(csvString, 'utf8');
    
    const uploadResult = await mediaManager.upload(
      "/StaffReports",
      buffer,
      `Full_Staff_Report_${Date.now()}.csv`,
      { mediaOptions: { mimeType: "text/csv" } }
    );

    return uploadResult.fileUrl;
  } catch (err) {
    console.error(err);
    return null;
  }
}