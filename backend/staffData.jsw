// Filename: backend/staffData.jsw
import wixData from 'wix-data';
import { currentMember } from 'wix-members-backend';

export async function getTeamManager(teamId) {
    // We use suppressAuth and suppressHooks to bypass the "Vault" permissions
    const options = { 
        "suppressAuth": true,
        "suppressHooks": true 
    };

    try {
        const results = await wixData.query("Teams")
            .eq("_id", teamId) 
            .include("T_teamManager") // DOUBLE CHECK: Is this the field key for the Manager Reference?
            .find(options);

        if (results.items.length > 0) {
            const teamItem = results.items[0];
            const manager = teamItem.T_teamManager;

            if (manager) {
                return {
                    "fullName": manager.SS_name || "Manager TBC",
                    "photo": manager.headshot || "https://static.wixstatic.com/media/your-default-avatar-link.png",
                    "team": teamItem.T_teamName,
                    // Added 2026-08-15 for Parent Hub v2's More > Club Contacts.
                    // Parents only ever see the manager of a team their own
                    // child is in - the repeater is built from their kids'
                    // teams, not every team at the club.
                    "mobile": manager.mobile || "",
                    "emailAddress": manager.emailAddress || ""
                };
            }
        }
        return null;
    } catch (error) {
        console.error("CRITICAL: Manager lookup failed for team " + teamId, error);
        return null;
    }
}

