// =====================================================================
//  recruitment.jsw — recruitment posters
// =====================================================================
//  A manager fills in a short form, the element draws a poster on a canvas,
//  and this saves it and publishes it.
//
//  THE PIPELINE, and why each piece is where it is:
//    element  draws the poster on <canvas> and exports a base64 PNG
//    here     uploads it to the Media Manager and records the post
//    blog.jsw publishes to the club website (already working - it's what
//             the news form uses)
//    later    Facebook, once the route is proven
//
//  Drawn on a canvas rather than rasterised from HTML because the element
//  runs in a sandboxed iframe where external libraries are a fight, and a
//  templated poster doesn't need DOM rendering. It also gives exact output
//  dimensions, which matters to Facebook.
//
//  ⚠️ POSTERS ARE PUBLIC FILES, deliberately. Facebook has to be able to
//  fetch the image by URL, and the club website shows it to anyone. That's
//  fine for a poster - it contains a squad name, a position and a manager's
//  club contact number, all of which are already public. It is NOT a
//  precedent for the children's ID documents in mediaUpload.jsw, which is a
//  separate and still-open decision.
//
//  FACEBOOK IS WIRED (2026-08-22) via backend/facebook.jsw.
//
//  EVERY MANAGER POSTS STRAIGHT OUT, decided 2026-08-22. Every field a
//  manager types is already drawn onto the poster and the poster already
//  goes public on the club website - so Facebook is a second destination
//  for content they could already publish, not a new channel for free
//  text. The `pending` status remains in the schema for POTM, which is a
//  different case: those posts carry a child's photograph.
// =====================================================================

import wixData from 'wix-data';
import { mediaManager } from 'wix-media-backend';
import { assertTeamAccess } from 'backend/managerData.jsw';
import { postPhotoToPage } from 'backend/facebook.jsw';
import { createBlogPost } from 'backend/blog.jsw';

const OPTIONS = { suppressAuth: true };

// A poster is around 200-400KB at the size the element exports. This is a
// long way clear of that while still refusing anything that could only be a
// mistake or an attempt to fill the Media Manager.
const MAX_BYTES = 5 * 1024 * 1024;

const FOLDER = "/Recruitment Posters";

// Everything the poster needs that shouldn't be typed: the squad's own
// details and the manager's real contact number. A poster with a wrong phone
// number is worse than no poster, and typing it is exactly how that happens.
export async function getRecruitContext(teamId) {
    try {
        const access = await assertTeamAccess(teamId);
        if (!access.ok) return { success: false, error: access.error };
        const ctx = access.ctx;

        // .include rather than a second get(): the age group is a reference
        // and one query is both fewer round trips and immune to getting the
        // collection name wrong (it's AgeGroup, singular).
        const teamRes = await wixData.query("Teams")
            .eq("_id", teamId)
            .include("AG_ageGroup")
            .find(OPTIONS);
        const team = teamRes.items[0];
        if (!team) return { success: false, error: "Team not found." };

        // ClubDictionary category `position`. Falls back to an empty list
        // rather than erroring - a missing dictionary shouldn't stop a
        // manager making a general recruitment poster.
        let positions = [];
        try {
            const posRes = await wixData.query("ClubDictionary")
                .eq("category", "position")
                .ascending("order")
                .limit(100)
                .find(OPTIONS);
            positions = posRes.items.map(r => ({ value: r.label || r.value || "", label: r.label || r.value || "" }))
                .filter(p => p.value);
        } catch (err) {
            console.error("[recruitment] position dictionary unavailable:", err.message);
        }

        // Seasons for the "FOR 2026/27 SEASON" line. Descending, so the
        // current one is first and becomes the default - a manager shouldn't
        // have to know what this season is called to make a poster.
        let seasons = [];
        try {
            const seasonRes = await wixData.query("ClubDictionary")
                .eq("category", "season")
                .descending("order")
                .limit(20)
                .find(OPTIONS);
            seasons = seasonRes.items.map(r => r.label || r.value || "").filter(Boolean);
        } catch (err) {
            console.error("[recruitment] season dictionary unavailable:", err.message);
        }

        return {
            success: true,
            teamId,
            seasons,
            season: seasons.length ? seasons[0] : "",
            teamName: team.T_teamName || "",
            ageGroup: (team.AG_ageGroup && team.AG_ageGroup.AG_ageGroup) || "",
            trainingDay: team.T_trainingDay || "",
            trainingTime: team.T_trainingStartTime || "",
            trainingPitch: team.trainingPitch || "",
            trainingLocation: (team.trainingLocation && team.trainingLocation.formatted) ||
                              (typeof team.trainingLocation === "string" ? team.trainingLocation : ""),
            managerName: ctx.name,
            managerPhone: ctx.mobile,
            positions
        };
    } catch (error) {
        console.error("getRecruitContext error:", error);
        return { success: false, error: "Couldn't load the poster details." };
    }
}

// base64 is the whole PNG, without the `data:image/png;base64,` prefix.
// Where the caption sends people. A named constant so it can be changed
// without going hunting through string concatenation.
const CLUB_URL = "www.signolathleticjfc.co.uk";

// What appears under the poster on Facebook.
//
// ⚠️ BUILT FROM THE PAYLOAD, NOT THE SAVED ROW. The first version read
// row.ageGroup, which the row has never had - so it silently produced a
// caption with the age group missing and no error anywhere. Anything the
// caption needs has to be saved on the row above or read from the payload
// here; reading a field that does not exist just yields undefined and a
// quietly worse post.
//
// Kept plain and factual: the poster carries the design, and a caption
// stuffed with hashtags reads like spam on a club page.
// ⚠️ THE TEAM NAME USUALLY ALREADY CONTAINS THE AGE GROUP. Joining them
// blindly produced "UNDER 12s U12 Eagles", because ageGroup is "UNDER 12s"
// and teamName is "U12 Eagles" - both true, together nonsense.
//
// So: if the team name already carries the age group's number, it is the
// more specific of the two and stands alone. Only when it doesn't - a team
// called just "Eagles" - are they joined, because then each says something
// the other doesn't.
function squadLabel(payload) {
    const age = String(payload.ageGroup || "").trim();
    const team = String(payload.teamName || "").trim();
    if (!team) return age;
    if (!age) return team;

    const num = (age.match(/[0-9]+/) || [])[0];
    if (num && team.indexOf(num) !== -1) return team;

    return age + " " + team;
}

function facebookCaption(payload, contactName) {
    const who = String(contactName || "").trim();
    const pos = String(payload.position || "").trim();
    const extra = String(payload.extraLine || "").trim();

    const squad = squadLabel(payload);

    const lines = ["We are recruiting!"];

    const detail = [];
    if (squad) detail.push(squad);
    if (pos) detail.push("looking for " + pos.toLowerCase());
    if (detail.length) lines.push(detail.join(" — ") + ".");

    if (extra) lines.push(extra);

    lines.push(
        (who ? "Contact " + who + " or visit " : "Visit ") + CLUB_URL
    );

    return lines.join("\n\n");
}

// The blog post's headline. Short and factual - it appears in the news feed
// alongside match reports, so it has to read as a club item, not a shout.
function blogTitle(payload) {
    const squad = squadLabel(payload);
    return squad ? (squad + " are looking for players") : "We are looking for players";
}

// Same words as the Facebook caption, as paragraphs. Escaped: a manager types
// every part of this and it lands on a public page.
function blogBody(payload, contactName) {
    return facebookCaption(payload, contactName)
        .split("\n\n")
        .map(function (para) {
            const safe = para
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;");
            return "<p>" + safe + "</p>";
        })
        .join("");
}

// What the manager is told happened. Composed from what was actually
// VERIFIED, not from what was requested.
//
// ⚠️ THIS USED TO LIE. Every branch said "saved for the website" whether or
// not anything had been published - and since nothing published at all, a
// silent no-op read as a success. Each destination now reports its own real
// outcome and the two are joined; no branch can claim one without checking.
function buildMessage(toWebsite, toFacebook, status, fb, blogPostId) {
    const parts = [];

    if (toWebsite) {
        parts.push(blogPostId
            ? "Posted to the club website."
            : "Saved, but it didn't reach the website — check the logs.");
    }

    if (toFacebook) {
        if (status === "pending") {
            parts.push("It needs approving before it goes on Facebook.");
        } else if (fb && fb.success) {
            parts.push("Posted to Facebook.");
        } else {
            parts.push("Facebook rejected it: " + ((fb && fb.error) || "unknown reason"));
        }
    }

    // Neither ticked still saves the poster, which is a real outcome worth
    // naming rather than returning an empty string.
    return parts.length ? parts.join(" ") : "Poster saved.";
}

export async function publishRecruitmentPost(teamId, payload = {}) {
    try {
        const access = await assertTeamAccess(teamId);
        if (!access.ok) return { success: false, error: access.error };
        const ctx = access.ctx;

        const toWebsite = payload.toWebsite === true;
        const toFacebook = payload.toFacebook === true;
        if (!toWebsite && !toFacebook) {
            return { success: false, error: "Pick at least one place to publish it." };
        }

        const base64 = String(payload.imageBase64 || "");
        if (!base64) return { success: false, error: "The poster image didn't come through." };

        // base64 inflates by roughly 4/3, so this checks the real decoded size
        // rather than the string length.
        const bytes = Math.floor(base64.length * 3 / 4);
        if (bytes > MAX_BYTES) {
            return { success: false, error: "That image is too big to upload." };
        }

        const stamp = new Date().toISOString().slice(0, 10);
        const safeTeam = String(payload.teamName || "team").replace(/[^A-Za-z0-9]+/g, "-").toLowerCase();
        const fileName = `recruit-${safeTeam}-${stamp}.png`;

        const uploaded = await mediaManager.upload(
            FOLDER,
            Buffer.from(base64, "base64"),
            fileName,
            {
                mediaOptions: { mimeType: "image/png", mediaType: "image" },
                // Public because Facebook must be able to fetch it and the
                // website shows it publicly anyway. See the header note.
                metadataOptions: { isPrivate: false, isVisitorUpload: false }
            }
        );

        // fileUrl is the wix:image:// URI; the https one is what an <img> and
        // an external service can actually load. Both are kept - Wix APIs
        // (like the Blog cover image) want the URI form, everything else
        // wants the URL.
        const posterUri = uploaded.fileUrl || uploaded.fileName || "";
        const posterUrl = (uploaded.fileUrl && uploaded.fileUrl.startsWith("http"))
            ? uploaded.fileUrl
            : "";

        const row = {
            team: teamId,
            // Joined from the chips, e.g. "Midfielders, Strikers". Kept as the
            // existing Text column rather than adding an array field - it's for
            // a human reading the list of past posters, not for querying.
            position: String(payload.position || "").trim(),
            extraLine: String(payload.extraLine || "").trim(),
            ageGroup: String(payload.ageGroup || "").trim(),
            contactName: String(payload.contactName || "").trim(),
            posterUrl: posterUri,
            toWebsite,
            toFacebook,
            // EVERY manager posts straight out - no approval step.
            //
            // The earlier caution was about handing volunteers a channel for
            // free text. It does not apply: extraLine, clubName, ageGroup,
            // teamName and the training details are all typed by the manager
            // and all DRAWN ONTO THE POSTER, which already goes public on the
            // club website. Facebook is a second destination for content they
            // could already publish, not a new way to say something new.
            //
            // To reintroduce approval, make this
            //   (toFacebook && !ctx.perms.allTeams) ? "pending" : "published"
            // and build the screen that clears the queue - nothing approves a
            // pending row today, so it would strand posts if added blind.
            status: "published",
            createdByStaff: ctx.staffId,
            publishedDate: new Date()
        };

        const saved = await wixData.insert("RecruitmentPosts", row, OPTIONS);

        // ⚠️ toWebsite USED TO DO NOTHING. The poster was uploaded and the row
        // saved, and that was it - nothing on the public site reads
        // RecruitmentPosts, so a manager ticked "post to the website", got a
        // success message, and nothing ever appeared. The header always said
        // blog.jsw was the route; it simply was not wired.
        //
        // Same pattern as teamAdmin.jsw's news publish, including its lesson:
        // memberId is REQUIRED and createBlogPost throws without it. This block
        // is wrapped in a catch, so passing null once failed completely
        // silently. The catch is deliberately LOUD for that reason.
        let blogPostId = "";
        if (toWebsite) {
            try {
                const blog = await createBlogPost({
                    title: blogTitle(payload),
                    bodyHtml: blogBody(payload, row.contactName),
                    // The wix:image:// URI, NOT the https URL - blog.jsw wants
                    // the URI form for the cover image. An https one gives
                    // "Media image not found".
                    featuredImage: posterUri,
                    // The poster is PORTRAIT, so the cover thumbnail crops it.
                    // Repeating it in the body is the only way a reader sees
                    // the whole thing.
                    bodyImage: true,
                    memberId: ctx.memberId
                });
                blogPostId = (blog && blog.blogPostId) || "";
                if (blogPostId) {
                    const fresh = await wixData.get("RecruitmentPosts", saved._id, OPTIONS);
                    fresh.blogPostId = blogPostId;
                    await wixData.update("RecruitmentPosts", fresh, OPTIONS);
                }
            } catch (blogErr) {
                // Non-fatal: the poster and the record are already saved, so a
                // blog failure must not lose the manager's work. But it has to
                // be loud - a silent catch here is what hid the missing-author
                // bug on the news form.
                console.error("[recruitment] blog publish FAILED, poster still saved. reason:",
                    blogErr && blogErr.message, blogErr);
            }
        }

        // ⚠️ SENT AFTER THE ROW IS SAVED, ON PURPOSE. A Facebook outage must
        // not lose a poster the manager just spent ten minutes on - the record
        // and the image survive regardless, and the post can be retried.
        let fbResult = null;
        if (toFacebook && row.status === "published") {
            // posterUri, not posterUrl: mediaManager returns a wix:image://
            // URI and posterUrl is only populated when it happens to be an
            // https one, which it is not. postPhotoToPage normalises either.
            fbResult = await postPhotoToPage(posterUri, facebookCaption(payload, row.contactName));

            if (fbResult.success) {
                await wixData.update("RecruitmentPosts",
                    Object.assign({}, saved, {
                        fbPostId: fbResult.postId || "",
                        fbPostedDate: new Date()
                    }), OPTIONS);
            } else {
                console.error("[recruitment] Facebook post failed for", saved._id,
                    "-", fbResult.error);
            }
        }

        return {
            success: true,
            id: saved._id,
            posterUri,
            posterUrl,
            status: row.status,
            blogPostId,
            websitePosted: toWebsite ? !!blogPostId : null,
            facebook: fbResult
                ? { posted: fbResult.success, error: fbResult.error || "",
                    tokenProblem: !!fbResult.tokenProblem }
                : null,
            message: buildMessage(toWebsite, toFacebook, row.status, fbResult, blogPostId)
        };
    } catch (error) {
        console.error("publishRecruitmentPost error:", error);
        return { success: false, error: "Couldn't publish that poster." };
    }
}

// What a manager has made before, so they can reuse or check one.
export async function getRecruitmentPosts(teamId) {
    try {
        const access = await assertTeamAccess(teamId);
        if (!access.ok) return { success: false, error: access.error };

        const res = await wixData.query("RecruitmentPosts")
            .eq("team", teamId)
            .descending("publishedDate")
            .limit(30)
            .find(OPTIONS);

        return {
            success: true,
            posts: res.items.map(p => ({
                id: p._id,
                position: p.position || "",
                status: p.status || "",
                toWebsite: p.toWebsite === true,
                toFacebook: p.toFacebook === true,
                date: p.publishedDate || p._createdDate || null
            }))
        };
    } catch (error) {
        console.error("getRecruitmentPosts error:", error);
        return { success: false, posts: [] };
    }
}
