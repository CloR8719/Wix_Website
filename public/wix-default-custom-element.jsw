class BadgeGrid extends HTMLElement {
  static get observedAttributes() { return ['badges']; }

  constructor() {
    super();
    this.attachShadow({ mode: 'open' });
    this._badges = [];
  }

  connectedCallback() {
    console.log("badge-grid connected");
    this.style.display = "block";
    this.style.minHeight = "60px";
    this.render();
  }

  attributeChangedCallback(name, oldValue, newValue) {
    if (name !== 'badges') return;
    console.log("badge-grid badges:", newValue);
    this._badges = JSON.parse(newValue || '[]');
    this.render();
  }

  render() {
    this.shadowRoot.innerHTML = `
      <style>
        :host { display:block; min-height:60px; }
        .container { display:flex; flex-wrap:wrap; gap:8px; justify-content:center; }
        .item { width:40px; height:40px; }
        img { width:100%; height:100%; object-fit:contain; display:block; }
      </style>
      <div class="container">
        ${(this._badges || []).map(url => `<div class="item"><img src="${url}" alt=""></div>`).join('')}
      </div>
    `;
  }
}

if (!customElements.get('badge-grid')) customElements.define('badge-grid', BadgeGrid);